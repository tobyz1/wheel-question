rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read:  if isAdmin() || isOwner(uid);
      allow write: if false;
    }

    match /questionSubmissions/{submissionId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['theme', 'text', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.status    == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.text      is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 500
        && request.resource.data.theme     is string
        && request.resource.data.theme.size() > 0;

      allow read:   if isAdmin() || isOwner(resource.data.createdBy);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'rejectionReason'])
        && request.resource.data.status in ['approved', 'rejected'];

      allow delete: if false;
    }

    match /questions/{theme}/items/{questionId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // Votes — CHEMIN COMPLET, pas imbriqué
    match /questions/{theme}/items/{questionId}/votes/{userId} {
      allow read:  if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
